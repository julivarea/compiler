/* Prueba de if - else if - else encadenados */
int clasificar(int n) {
    if (n < 0) {
        return 1;
    } else if (n == 0) {
        return 10;
    } else if (n < 10) {
        return 20;
    } else {
        return 30;
    }
}

int main() {
    int total;
    total = 0;
    total += clasificar(-5);  // +1  -> 1
    total += clasificar(0);   // +10 -> 11
    total += clasificar(5);   // +20 -> 31
    total += clasificar(50);  // +30 -> 61
    return total;             // Esperado: 61
}
